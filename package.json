{
    "name": "customer-activity-service",
    "version": "1.0.0",
    "private": true,
    "description": "Fully managed RESTful APIs for the Customer Activity Management service.",
    "keywords": [
        "nodejs-application",
        "customer-activity",
        "restful-apis"
    ],
    "homepage": "https://github.com/nikhilkumarsingh-in/customer-activity-service#readme",
    "bugs": {
        "url": "https://github.com/nikhilkumarsingh-in/customer-activity-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nikhilkumarsingh-in/customer-activity-service.git"
    },
    "license": "UNLICENSED",
    "author": "Nikhil Kumar Singh <nikhilkumarsingh.in@gmail.com>",
    "main": "./dist/server.js",
    "type": "module",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/server.ts",
        "start": "cross-env NODE_ENV=production node ./dist/server.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.0",
        "cross-env": "^10.1.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "morgan": "^1.12.0",
        "zod": "^4.5.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
