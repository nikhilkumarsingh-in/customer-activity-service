{
    "name": "customer-activity-service",
    "version": "1.0.0",
    "private": true,
    "description": "Fully managed RESTful APIs for the Customer Activity Management service.",
    "keywords": [
        "nodejs-application",
        "customer-activity",
        "restful-apis"
    ],
    "homepage": "https://github.com/nikhilkumarsingh-in/customer-activity-service#readme",
    "bugs": {
        "url": "https://github.com/nikhilkumarsingh-in/customer-activity-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nikhilkumarsingh-in/customer-activity-service.git"
    },
    "license": "UNLICENSED",
    "author": "Nikhil Kumar Singh <nikhilkumarsingh.in@gmail.com>",
    "main": "./dist/server.js",
    "type": "module",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/server.ts",
        "start": "cross-env NODE_ENV=production node ./dist/server.js",
        "clean:dist": "node ./scripts/remove-dist.script.js",
        "autocannon:customers:create": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/create.customer.js",
        "autocannon:customers:search": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/search.customer.js",
        "autocannon:customers:timeline": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/get-timeline.customer.js",
        "autocannon:customers:get-details": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/get-details.customer.js",
        "autocannon:customers:update-details": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/update-details.customer.js",
        "autocannon:customers:update-status": "cross-env NODE_ENV=development node ./scripts/autocannon/customers/update-status.customer.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.0",
        "autocannon": "^8.0.0",
        "cross-env": "^10.1.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "libphonenumber-js": "^1.13.12",
        "mongoose": "^9.9.4",
        "morgan": "^1.12.0",
        "zod": "^4.5.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
